{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClawScope",
  "version": "0.1.0",
  "identifier": "com.claw.scope",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ClawScope - 记忆可见，进化可期",
        "width": 1024,
        "height": 768,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "OpenClaw 记忆与进化管理工具",
    "longDescription": "ClawScope 提供记忆可见、配置可编辑、进化可实验的本地管理能力。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": []
  }
}
